# Q4_wyhnew 的 git 忽略规则
#
# 目的：让这个文件夹既能在磁盘上独立完整运行，又不会把大体积累积进 git。
# 被忽略的都是“可由脚本重新生成”的中间产物，或已在别处纳管的原始数据副本。
# 官方正式结果（Results/Tables/result4-2.xlsx）与官方那一格的 pkl 仍然入库。

# 大体积场景文件（每个 13 至 37 MB，可由 05_q4_scenarios.py 重新生成）
Data_processing/scenarios_M*.pkl

# 主模型滚动结果（38 MB，可由 q4_2_rolling.py --mode full 重新生成）
Data_processing/*_results.pkl

# 变体跑批结果（每个约 5 MB，可由 q4_2_variants.py 重新生成）
Data_processing/variants/*.pkl
# 例外：附件3 口径那一格是新主口径的正式结果来源，需要入库
!Data_processing/variants/V_official_unknown_q2params_results.pkl

# 官方附件副本与中间 parquet（原仓库已纳管，这里只是运行所需副本）
Data/附件/*.xlsx
others/原始附件_CUMCM2026_C/**
All_Code/Data_preprocessing/Data_transformation/*.parquet
All_Code/Data_preprocessing/Data_clean/*.csv

# Q2 已定稿产物（原仓库已纳管）
All_Code/Q2_yy/Data_processing/*.pkl

# Python 缓存
__pycache__/
*.pyc
